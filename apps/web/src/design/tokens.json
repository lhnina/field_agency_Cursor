{
  "$schema": "https://fieldops.local/design-tokens.schema.json",
  "meta": {
    "product": "FieldOps",
    "direction": "Atlantic Ops",
    "version": "1.0.0-etapa-d",
    "updated": "2026-11-02",
    "locale": "pt-PT",
    "cssPrefix": "--fo-",
    "referenceCss": "../design-screens/assets/tokens.css"
  },
  "color": {
    "brand": {
      "DEFAULT": "#0C6E5C",
      "hover": "#095A4B",
      "pressed": "#074A3D",
      "subtle": "#E6F3EF",
      "muted": "#9BC5B8"
    },
    "accent": {
      "DEFAULT": "#E08A2B",
      "hover": "#C9741A",
      "subtle": "#FDF3E6"
    },
    "ink": {
      "DEFAULT": "#15202B",
      "secondary": "#4A5B6C",
      "muted": "#7A8B9A"
    },
    "surface": {
      "canvas": "#EEF1F4",
      "DEFAULT": "#FFFFFF",
      "raised": "#F7F9FA"
    },
    "border": {
      "DEFAULT": "#D5DCE3",
      "strong": "#B8C2CC"
    },
    "sidebar": {
      "bg": "#F7F9FA",
      "border": "#E2E8EE"
    },
    "semantic": {
      "success": { "DEFAULT": "#1F7A4D", "subtle": "#E5F5EC" },
      "warning": { "DEFAULT": "#C27803", "subtle": "#FDF4E3" },
      "danger": { "DEFAULT": "#C23B3B", "subtle": "#FBEAEA" },
      "info": { "DEFAULT": "#2B6CB0", "subtle": "#E8F1FA" }
    },
    "service": {
      "reposicao": "#0C6E5C",
      "promocao": "#2B6CB0",
      "logistica": "#6B5B95",
      "equipas": "#8A6D3B",
      "unassigned": "#E08A2B"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Plus Jakarta Sans", "system-ui", "sans-serif"],
      "mono": ["IBM Plex Mono", "ui-monospace", "monospace"]
    },
    "fontSize": {
      "display": { "size": "22px", "weight": 700, "letterSpacing": "-0.03em" },
      "title": { "size": "16px", "weight": 700 },
      "titleSm": { "size": "14px", "weight": 700 },
      "body": { "size": "14px", "weight": 400 },
      "bodySm": { "size": "13.5px", "weight": 500 },
      "table": { "size": "13px", "weight": 400 },
      "label": { "size": "12px", "weight": 600 },
      "labelTable": { "size": "11px", "weight": 700, "letterSpacing": "0.03em", "textTransform": "uppercase" },
      "caption": { "size": "12px", "weight": 400 },
      "kpi": { "size": "22px", "weight": 600, "fontFamily": "mono", "letterSpacing": "-0.03em" },
      "kpiLg": { "size": "28px", "weight": 600, "fontFamily": "mono" },
      "navSection": { "size": "10px", "weight": 700, "letterSpacing": "0.06em", "textTransform": "uppercase" }
    }
  },
  "layout": {
    "sidebarWidth": "240px",
    "headerHeight": "56px",
    "drawerWidth": "380px",
    "contentPadding": "24px",
    "panelGap": "14px",
    "kpiGap": "12px",
    "targetViewport": { "width": 1440, "height": 900 },
    "breakpointStack": 1100
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "10px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(21, 32, 43, 0.05)",
    "md": "0 4px 12px rgba(21, 32, 43, 0.08)"
  },
  "motion": {
    "fast": "120ms",
    "toastMs": 2800
  },
  "component": {
    "buttonHeight": "36px",
    "fieldHeight": "34px",
    "badgeHeight": "22px",
    "iconButtonSize": "36px",
    "avatarSize": "32px",
    "focusRing": "2px solid #0C6E5C",
    "focusOffset": "2px",
    "disabledOpacity": 0.45
  }
}
